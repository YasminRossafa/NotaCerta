# Provedor de IA usado em /api/corrigir: "gemini" (padrão, camada gratuita) ou "anthropic".
AI_PROVIDER=gemini

# Chave secreta do Google AI Studio — só no servidor. NUNCA commitar, NUNCA NEXT_PUBLIC_.
# Como obter: veja a seção "Como obter a chave gratuita" do README.
GEMINI_API_KEY=

# Modelo Gemini a usar — escolha um que mostre acesso gratuito no Google AI Studio
# (família Flash ou Flash-Lite). Preencha com o id exato mostrado lá, ex.: gemini-flash-latest.
GEMINI_MODEL=

# Chave secreta da Anthropic — só no servidor. NUNCA commitar, NUNCA usar prefixo NEXT_PUBLIC_.
# Só é necessária se AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Modelo usado quando AI_PROVIDER=anthropic (geração Sonnet 5; o spec cita "claude-sonnet-5-5").
ANTHROPIC_MODEL=claude-sonnet-5

# Correções grátis por dia por dispositivo (rate limit da rota /api/corrigir).
NOTACERTA_FREE_LIMIT_DIARIO=1

# Reservado: limite mensal de correções grátis por dispositivo (ainda não lido pelo código —
# a rota usa NOTACERTA_FREE_LIMIT_DIARIO acima; ajuste lib/server/rate-limit.ts para ligar este).
NOTACERTA_FREE_LIMIT_MENSAL=2

# Opcional: URL pública do site (canonical/OpenGraph). Pode ser exposta ao cliente.
NEXT_PUBLIC_SITE_URL=https://notacerta.vercel.app
